{
  "_comment": [
    "Source of truth for every version number shown on code.matx.ca.",
    "Nothing here is a version string: versions come from GitHub Releases at build time.",
    "Run scripts/update-versions.py to refresh index.html; --check fails if it is stale.",
    "",
    "  repo         owner/name of the PUBLIC repo the release is published to.",
    "  title_match  optional regex against the release TITLE, for repos that ship",
    "               several apps (macvfx/MHL ships five). Omit to accept any release.",
    "  channel      'stable' = newest non-prerelease (falls back to newest overall),",
    "               'latest' = newest release of any kind, for apps on a beta track.",
    "  label        how the app is named on the site, for the generated report only.",
    "  url          optional: where the app's button goes instead of the repo's releases page.",
    "  fixed        optional {version, build, published}: show this app at a typed version with no release",
    "               lookup. For an app that ships inside another app's release (Drop Verify and Folder Copy",
    "               Compare ride in the CopyTrust release): update it by hand when the app is rebuilt."
  ],
  "apps": {
    "p5-archive-manager": {
      "label": "P5 Archive Manager CLI",
      "repo": "macvfx/p5ArchiveManager",
      "title_match": "^(?!API version)",
      "channel": "stable"
    },
    "p5-archive-manager-api": {
